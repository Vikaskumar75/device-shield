<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Screenshot detection (ScreenshotDetector.kt) — Android 14+ (API 34)
    gates Activity#registerScreenCaptureCallback() behind this permission.
    Without it that call throws SecurityException the moment the plugin
    attaches to an Activity, taking down the host app before any Dart runs.

    A normal (non-dangerous) permission: granted at install time, no runtime
    prompt, no host-app change required — it merges into the host manifest
    automatically via Gradle. Ignored by devices below API 34, where
    ScreenshotDetector.isSupported is false and start() no-ops anyway.
  -->
  <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

  <!--
    FR-01 root detection (RootDetector.kt) — Android 11+ (API 30) restricts
    PackageManager#getPackageInfo() for a specific package name to
    NameNotFoundException unless declared here or covered by the
    QUERY_ALL_PACKAGES permission (deliberately not used — see
    RootDetector.kt's own doc comment). These <package> entries merge into
    the host app's manifest automatically via Gradle; no host-app change
    required. Declaring a package here does not request any permission and
    triggers no runtime prompt.
  -->
  <queries>
    <package android:name="com.topjohnwu.magisk" />
    <package android:name="eu.chainfire.supersu" />
    <package android:name="com.noshufou.android.su" />
    <package android:name="com.noshufou.android.su.elite" />
    <package android:name="com.koushikdutta.superuser" />
    <package android:name="com.thirdparty.superuser" />
    <package android:name="com.yellowes.su" />
    <package android:name="com.kingroot.kinguser" />
    <package android:name="com.kingo.root" />
    <package android:name="com.smedialink.oneclickroot" />
    <package android:name="com.zhiqupk.root.global" />
    <package android:name="me.phh.superuser" />
    <package android:name="com.ramdroid.appquarantine" />
    <package android:name="com.amphoras.hidemyroot" />
    <package android:name="com.amphoras.hidemyrootadfree" />
    <package android:name="com.formyhm.hideroot" />
    <package android:name="com.formyhm.hiderootpremium" />
    <package android:name="com.zachspong.temprootremovejb" />
    <package android:name="com.devadvance.rootcloak" />
    <package android:name="com.devadvance.rootcloakplus" />
    <package android:name="com.saurik.substrate" />

    <!--
      FR-06 mock location detection (MockLocationDetector.kt) — same
      Android 11+ <queries> requirement as the root-detection block
      above, for the fake-GPS app package list.
    -->
    <package android:name="com.lexa.fakegps" />
    <package android:name="com.incorporateapps.fakegps.fre" />
    <package android:name="com.blogspot.newapphorizons.fakegps" />
    <package android:name="com.gsmartstudio.fakegps" />
    <package android:name="com.evezzon.fakegps" />
    <package android:name="com.rosteam.gpsemulator" />
    <package android:name="com.fakegps.mock" />
    <package android:name="com.theappninjas.fakegpsjoystick" />
    <package android:name="com.jinseiapp.fakegps" />
    <package android:name="ru.gavrikov.mocklocations" />
  </queries>
</manifest>
