---
// The landing page. Rendered inside Starlight's splash template (see
// src/content/docs/index.mdx), so it inherits the site header, theme
// switcher and colour tokens. Everything here opts out of Markdown styling
// with `not-content`.
import { Code } from '@astrojs/starlight/components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const repo = 'https://github.com/Vikaskumar75/device-shield';

const heroCode = `import 'package:device_shield/device_shield.dart';

final report = await DeviceShield.check();

if (report.root.detected) {
  // Which signals fired, and how strongly
  print(report.root.signals);
}`;

type Support = 'yes' | 'partial' | 'no';
interface Feature {
  title: string;
  body: string;
  href: string;
  android: Support;
  ios: Support;
  icon: string;
}

const features: Feature[] = [
  {
    title: 'Root & jailbreak',
    body: 'su binaries, Magisk artifacts, root and cloaking apps, a writable system partition on Android. Cydia, Sileo, sandbox escapes and library injection on iOS.',
    href: 'detection/root/',
    android: 'yes',
    ios: 'yes',
    icon: 'M12 3 4 6v6c0 4.6 3.4 8.4 8 9 4.6-.6 8-4.4 8-9V6l-8-3Z',
  },
  {
    title: 'Emulator & simulator',
    body: 'Build fingerprint, model, hardware and QEMU pipes on Android. The simulator build target on iOS.',
    href: 'detection/emulator/',
    android: 'yes',
    ios: 'yes',
    icon: 'M5 4h14v12H5zM9 20h6M12 16v4',
  },
  {
    title: 'Debugger',
    body: 'An attached or awaited debugger and debuggable builds on Android. The kernel’s traced-process flag on iOS.',
    href: 'detection/debugger/',
    android: 'yes',
    ios: 'yes',
    icon: 'M8 8h8v9a4 4 0 0 1-8 0V8ZM9 5l1.5 3M15 5l-1.5 3M4 12h4M16 12h4M4 17h4M16 17h4',
  },
  {
    title: 'Mock location',
    body: 'The platform’s mock-provider flag, the selected mock-location app and known fake-GPS apps on Android. Limited on iOS today.',
    href: 'detection/mock-location/',
    android: 'yes',
    ios: 'partial',
    icon: 'M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Zm0-9.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  },
  {
    title: 'Screenshots & recording',
    body: 'Know when a screenshot is taken (Android 14+ and iOS) and when the screen is recorded or mirrored (iOS).',
    href: 'detection/screenshot/',
    android: 'partial',
    ios: 'yes',
    icon: 'M4 8V5h3M20 8V5h-3M4 16v3h3M20 16v3h-3M12 14.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  },
  {
    title: 'Capture protection',
    body: 'Block screenshots, recording and the Recents thumbnail with FLAG_SECURE on Android. Blur the app-switcher snapshot on iOS.',
    href: 'protection/screenshot/',
    android: 'yes',
    ios: 'partial',
    icon: 'M6 11V8a6 6 0 1 1 12 0v3M5 11h14v10H5z',
  },
];

interface Upcoming {
  title: string;
  body: string;
  platforms: string;
}

// Planned, not built. Keep in sync with src/content/docs/reference/roadmap.mdx.
const upcoming: Upcoming[] = [
  {
    title: 'Runtime hook detection',
    body: 'Detect instrumentation frameworks such as Frida, Xposed and Substrate hooking into your app.',
    platforms: 'Android & iOS',
  },
  {
    title: 'App integrity',
    body: 'Hand you Play Integrity and App Attest tokens for your server to verify. Requires a backend.',
    platforms: 'Android & iOS',
  },
  {
    title: 'Developer options & overlays',
    body: 'Flag enabled developer options and screen overlays that can be used for tapjacking.',
    platforms: 'Android',
  },
  {
    title: 'More recording & location signals',
    body: 'Screen-recording detection on Android 15+, and simulated-location detection on iOS 15+.',
    platforms: 'Android & iOS',
  },
];

const supportLabel: Record<Support, string> = {
  yes: 'Supported',
  partial: 'Limited',
  no: 'Not available',
};

const facts = [
  { value: 'Android & iOS', label: 'one Dart API' },
  { value: 'No network', label: 'nothing leaves the device' },
  { value: 'No data collected', label: 'empty privacy manifest' },
  { value: 'BSD-3', label: 'open source' },
];

const honesty = [
  {
    token: 'notApplicable',
    title: 'Says when a check can’t run',
    body: 'Ask for jailbreak detection on Android and you get “not applicable”, never a false “clear”.',
  },
  {
    token: 'signals + strength',
    title: 'Shows its evidence',
    body: 'Every result lists the signals that fired and how strong each is. Weak ones never decide on their own.',
  },
  {
    token: 'failed',
    title: 'Fails loudly',
    body: 'A check that errors or times out comes back as failed. It never quietly turns into a clean result.',
  },
];
---

<div class="landing not-content">
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-copy">
      <a class="eyebrow" href={link('introduction/#project-status')}>
        <span class="dot"></span> Pre-release · Android &amp; iOS
      </a>
      <h1>Know when your Flutter app is running somewhere it shouldn’t.</h1>
      <p class="lede">
        <code>device_shield</code> gives you root, jailbreak, emulator, debugger and mock-location
        signals from one package, and tells you plainly when a check can’t run.
      </p>
      <div class="actions">
        <a class="btn primary" href={link('installation/')}>Get started</a>
        <a class="btn ghost" href={repo}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"
            ></path></svg
          >
          GitHub
        </a>
      </div>
      <p class="install"><span>$</span> flutter pub add device_shield <em>0.1.0 coming soon</em></p>
    </div>
    <div class="hero-code">
      <div class="window">
        <div class="window-bar"><span></span><span></span><span></span><b>main.dart</b></div>
        <Code code={heroCode} lang="dart" frame="none" />
      </div>
      <div class="result">
        <div class="result-row"><span>check</span><code>root</code></div>
        <div class="result-row"><span>status</span><code class="warn">detected</code></div>
        <div class="result-row">
          <span>signals</span><code>su_binary_path · strong</code>
        </div>
        <div class="result-row"><span></span><code>busybox_present · weak</code></div>
      </div>
    </div>
  </section>

  <section class="facts" aria-label="At a glance">
    {
      facts.map((f) => (
        <div class="fact">
          <strong>{f.value}</strong>
          <span>{f.label}</span>
        </div>
      ))
    }
  </section>

  <section class="section">
    <header class="section-head">
      <p class="kicker">What it checks</p>
      <h2>The runtime checks security reviews ask for, in one package.</h2>
      <p>
        Pre-release: Android behaviour has not yet been verified on a physical device. See{' '}
        <a href={link('reference/platform-support/')}>platform support</a> for what has been tested.
      </p>
    </header>
    <div class="features">
      {
        features.map((f) => (
          <a class="feature" href={link(f.href)}>
            <svg class="feature-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d={f.icon} />
            </svg>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <div class="chips">
              <span class={`chip ${f.android}`} title={`Android: ${supportLabel[f.android]}`}>
                Android · {supportLabel[f.android]}
              </span>
              <span class={`chip ${f.ios}`} title={`iOS: ${supportLabel[f.ios]}`}>
                iOS · {supportLabel[f.ios]}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <header class="section-head">
      <p class="kicker">Coming soon</p>
      <h2>What we're building next.</h2>
      <p>
        Planned, not yet available. Order and timing can change. Follow the{' '}
        <a href={link('reference/roadmap/')}>roadmap</a> for status.
      </p>
    </header>
    <div class="upcoming">
      {
        upcoming.map((u) => (
          <div class="upcoming-card">
            <div class="upcoming-top">
              <span class="pill">Planned</span>
              <span class="upcoming-platforms">{u.platforms}</span>
            </div>
            <h3>{u.title}</h3>
            <p>{u.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <header class="section-head">
      <p class="kicker">Honest by design</p>
      <h2>A security SDK that overclaims is worse than none.</h2>
      <p>
        Every result says whether a check ran, what it found, and how sure it is. You decide what
        to do about it.
      </p>
    </header>
    <div class="honesty">
      {
        honesty.map((h) => (
          <div class="honest">
            <code>{h.token}</code>
            <h3>{h.title}</h3>
            <p>{h.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section model">
    <div>
      <p class="kicker">Security model</p>
      <h2>Risk signals, not a guarantee.</h2>
      <p>
        These checks run on a device the user controls, so a determined attacker can hide root or
        hook the checks themselves. Use <code>device_shield</code> to raise the cost of tampering and
        to adapt your app’s behaviour. For hard guarantees, pair it with server-verified attestation.
      </p>
      <a class="text-link" href={link('concepts/security-model/')}>Read the security model →</a>
    </div>
    <ul class="model-list">
      <li class="ok"><b>Good for</b> flagging risky devices, gating sensitive screens, fraud signals, analytics</li>
      <li class="ok"><b>Good for</b> keeping screenshots out of banking and health screens on Android</li>
      <li class="no"><b>Not a replacement for</b> Play Integrity or App Attest</li>
      <li class="no"><b>Not a replacement for</b> server-side authorisation</li>
    </ul>
  </section>

  <section class="cta">
    <h2>Start with the docs.</h2>
    <p>Installation, platform setup, and what every signal means.</p>
    <div class="actions">
      <a class="btn primary" href={link('introduction/')}>Read the docs</a>
      <a class="btn ghost" href={link('reference/platform-support/')}>Platform support</a>
    </div>
  </section>
</div>

<style is:global>
  /* The splash template renders the page title above custom content; the
     hero below has its own heading. */
  .content-panel h1#_top {
    display: none;
  }
</style>

<style>
  .landing {
    --radius: 14px;
    /* The hero background extends past the content column; clip it here so
       it never widens the page. `clip` (unlike `hidden`) leaves vertical
       overflow visible and creates no scroll container. */
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    gap: 6rem;
    padding-block: 2rem 4rem;
  }

  /* Hero */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: center;
  }
  .hero-grid {
    position: absolute;
    inset: -6rem -50vw -2rem;
    z-index: -1;
    background:
      radial-gradient(40rem 22rem at 70% 35%, var(--ds-glow), transparent 70%),
      linear-gradient(var(--ds-border) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, var(--ds-border) 1px, transparent 1px) 0 0 / 44px 44px;
    mask-image: radial-gradient(ellipse 60% 70% at 50% 40%, #000 20%, transparent 75%);
    opacity: 0.55;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--ds-border);
    border-radius: 999px;
    background: var(--ds-surface);
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
  }
  .eyebrow:hover {
    border-color: var(--sl-color-accent);
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ds-warn);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ds-warn) 25%, transparent);
  }
  h1 {
    margin: 1.25rem 0 1rem;
    font-size: clamp(2.3rem, 4.6vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    max-width: 34rem;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .lede code,
  .model code {
    font-size: 0.92em;
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.3rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn.primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  :root[data-theme='light'] .btn.primary {
    color: #fff;
  }
  .btn.primary:hover {
    background: var(--sl-color-accent-high);
  }
  :root[data-theme='light'] .btn.primary:hover {
    background: var(--sl-color-accent-high);
  }
  .btn.ghost {
    border: 1px solid var(--ds-border);
    background: var(--ds-surface);
    color: var(--sl-color-white);
  }
  .btn.ghost:hover {
    border-color: var(--sl-color-gray-3);
  }
  .install {
    margin: 1.5rem 0 0;
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }
  .install span {
    color: var(--sl-color-accent);
    margin-right: 0.4rem;
  }
  .install em {
    margin-left: 0.6rem;
    font-style: normal;
    font-family: var(--sl-font);
    font-size: 0.72rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--ds-border);
    border-radius: 999px;
  }

  .hero-code {
    position: relative;
  }
  .window {
    border: 1px solid var(--ds-border);
    border-radius: var(--radius);
    background: var(--ds-code-bg);
    overflow: hidden;
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset;
  }
  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--ds-border);
  }
  .window-bar span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--ds-border);
  }
  .window-bar b {
    margin-left: 0.6rem;
    font: 500 0.75rem var(--sl-font-mono);
    color: var(--ds-muted);
  }
  .window :global(.expressive-code) {
    margin: 0;
  }
  .window :global(.expressive-code pre) {
    border: 0 !important;
    background: transparent !important;
  }
  .result {
    position: relative;
    margin: -1.5rem -1rem 0 auto;
    width: min(21rem, 90%);
    padding: 0.9rem 1rem;
    border: 1px solid var(--ds-border);
    border-radius: 12px;
    background: color-mix(in srgb, var(--ds-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 20px 40px -18px rgba(0, 0, 0, 0.5);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }
  .result-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.2rem 0;
  }
  .result-row span {
    color: var(--ds-muted);
  }
  .result-row code {
    color: var(--sl-color-white);
    text-align: right;
  }
  .result-row code.warn {
    color: var(--ds-warn);
  }

  /* Facts strip */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--ds-border);
    border-radius: var(--radius);
    background: var(--ds-surface);
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1.25rem 1.5rem;
  }
  .fact + .fact {
    border-left: 1px solid var(--ds-border);
  }
  .fact strong {
    color: var(--sl-color-white);
    font-size: 1.05rem;
  }
  .fact span {
    color: var(--ds-muted);
    font-size: 0.85rem;
  }

  /* Sections */
  .section-head {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }
  .kicker {
    margin: 0 0 0.6rem;
    color: var(--sl-color-accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .section-head a {
    color: var(--sl-color-accent);
  }
  .section-head p:not(.kicker) {
    margin: 1rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--sl-color-white);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem;
    border: 1px solid var(--ds-border);
    border-radius: var(--radius);
    background: var(--ds-surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .feature:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }
  .feature p {
    margin: 0;
    flex: 1;
    color: var(--sl-color-gray-2);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .feature-icon {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.45rem;
    border-radius: 10px;
    background: var(--sl-color-accent-low);
    fill: none;
    stroke: var(--sl-color-accent-high);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }
  .chip {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--ds-border);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ds-muted);
  }
  .chip.yes {
    color: var(--ds-ok);
    border-color: color-mix(in srgb, var(--ds-ok) 35%, transparent);
  }
  .chip.partial {
    color: var(--ds-warn);
    border-color: color-mix(in srgb, var(--ds-warn) 35%, transparent);
  }

  .upcoming {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .upcoming-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    border: 1px dashed var(--ds-border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--ds-surface) 60%, transparent);
  }
  .upcoming-card p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .upcoming-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .pill {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .upcoming-platforms {
    color: var(--ds-muted);
    font-size: 0.75rem;
  }
  .honesty {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .honest {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem;
    border-top: 2px solid var(--sl-color-accent);
    background: linear-gradient(var(--ds-surface-raised), transparent);
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .honest code {
    align-self: flex-start;
    font-size: 0.8rem;
    color: var(--sl-color-accent-high);
  }
  .honest p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .model {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 2.5rem;
    border: 1px solid var(--ds-border);
    border-radius: 18px;
    background: var(--ds-surface);
