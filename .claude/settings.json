{
  "plansDirectory": "docs/plans",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking git guard"
          }
        ]
      }
    ]
  }
}
